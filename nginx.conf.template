# nginx:alpine 공식 이미지의 docker-entrypoint가 컨테이너 시작 시 이 템플릿을
# envsubst로 처리해서 /etc/nginx/conf.d/default.conf 로 만들어줍니다.
# ${BACKEND_UPSTREAM} 만 실제 값으로 치환되어야 하므로, nginx가 자체적으로
# 쓰는 변수($uri, $host 등)는 전부 $$ 로 이스케이프해서 그대로 남깁니다.

server {
    listen       80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # SPA 라우팅 (내부적으로 상태 기반 화면 전환을 쓰더라도, 새로고침/딥링크
    # 대비용으로 안전하게 넣어둡니다)
    location / {
        try_files $$uri /index.html;
    }

    # 백엔드(FastAPI)로 그대로 넘기는 경로들.
    # 프론트 코드가 실제로 호출하는 경로 기준(auth.js, prApi.ts, items.ts 등)
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM}/api/;
        proxy_set_header Host $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
    }

    location /purchase/ {
        proxy_pass http://${BACKEND_UPSTREAM}/purchase/;
        proxy_set_header Host $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
    }
}
